<resources>
    <!-- Base application theme. Apple Books 风格浅色主题 -->
    <style name="Theme.Malguem" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>

    <!-- 阅读界面: 开屏就没有状态栏, 免得先闪一下时间/wifi 那行 (运行期由 Fullscreen 维持) -->
    <style name="Theme.Malguem.Reader" parent="Theme.Malguem">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
