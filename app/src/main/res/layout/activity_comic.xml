<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- 左右 WebView 的水平布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左边的 WebView -->
        <WebView
            android:id="@+id/comicLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_weight="1" />

        <!-- 右边的 WebView -->
        <WebView
            android:id="@+id/comicRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 翻页遮罩: 左右是两个各自独立渲染的 WebView, 完成时刻对不齐.
         不遮的话会看到一边先换一边后换, 像一下翻了两页. 盖住等两边都就绪再一起揭开.
         背景色由 applyLayout 跟随书的背景设置, 揭开前后看起来就是整屏一次换页 -->
    <View
        android:id="@+id/pageMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:visibility="gone" />

    <!-- 翻页/预取未就绪时的小转圈 -->
    <ProgressBar
        android:id="@+id/pageLoading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- 用于显示页码的 TextView -->
    <TextView
        android:id="@+id/pageNumberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/page_pill"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/on_cover"
        android:textSize="14sp" />

</FrameLayout>
